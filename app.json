{
  "expo": {
    "name": "Wanderwish",
    "slug": "frontend",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/app-logo.png",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.aswin2405.frontend"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/app-logo.png",
        "backgroundImage": "./assets/app-logo.png",
        "monochromeImage": "./assets/app-logo.png"
      },
      "permissions": [
        "android.permission.RECORD_AUDIO"
      ],
      "package": "com.aswin2405.frontend"
    },
    "web": {
      "favicon": "./assets/app-logo.png"
    },
    "plugins": [
      [
        "expo-image-picker",
        {
          "photosPermission": "Allow $(PRODUCT_NAME) to access your photos so you can set a profile picture."
        }
      ],
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-screen.png",
          "resizeMode": "cover",
          "backgroundColor": "#FDF3EF"
        }
      ],
      "expo-font"
    ],
    "extra": {
      "eas": {
        "projectId": "8bdc802f-29cc-4fa6-adbb-26d8c96d3e7d"
      }
    }
  }
}
